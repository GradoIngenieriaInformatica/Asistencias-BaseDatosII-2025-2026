db.tu_coleccion.aggregate([
  // Etapa 1: FILTRAR (Equivale al WHERE / MATCH)
  { 
    $match: { 
      "campo_a_filtrar": "valor_o_condicion" 
    } 
  },

  // Etapa 2: AGRUPAR Y CONTAR/SUMAR (Equivale al GROUP BY / WITH-COUNT)
  { 
    $group: { 
      _id: "$campo_por_el_que_agrupas", 
      "nombre_del_total": { $sum: 1 } // Pon 1 para CONTAR, o "$campo" para SUMAR valores
    } 
  },

  // Etapa 3: ORDENAR (Equivale al ORDER BY)
  { 
    $sort: { 
      "nombre_del_total": -1 // -1 para Mayor a Menor (Desc), 1 para Menor a Mayor (Asc)
    } 
  }
])



